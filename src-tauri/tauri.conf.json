{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Bento",
    "version":  "0.2.0",
    "identifier":  "com.bento.desktop",
    "build":  {
                  "frontendDist":  "../dist",
                  "devUrl":  "http://localhost:5420",
                  "beforeDevCommand":  "",
                  "beforeBuildCommand":  "pnpm build \u0026\u0026 pnpm ponte:build"
              },
    "app":  {
                "windows":  [

                            ],
                "withGlobalTauri":  false,
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; connect-src \u0027self\u0027 ipc: http://ipc.localhost http://127.0.0.1:47831; img-src \u0027self\u0027 data: blob: https:; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; font-src \u0027self\u0027 data:; script-src \u0027self\u0027 \u0027wasm-unsafe-eval\u0027; media-src \u0027self\u0027 data: blob:; frame-src \u0027self\u0027 blob:"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.ico"
                            ],
                   "resources":  {
                                     "recursos/node.exe":  "recursos/node.exe",
                                     "recursos/ponte.mjs":  "recursos/ponte.mjs"
                                 },
                   "shortDescription":  "Bento, seu sistema de vida para Windows",
                   "windows":  {
                                   "nsis":  {
                                                "installMode":  "currentUser",
                                                "languages":  [
                                                                  "PortugueseBR"
                                                              ],
                                                "displayLanguageSelector":  false
                                            }
                               },
                   "createUpdaterArtifacts":  true
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2QUExRjREQzc2REQ0RkMKUldUODFHM0hUUitxZHBpMWg2ejAyLzNuQmgrNk5HZ0FWSzlQYll0L0pEQ1FvdFZKbE5hODM1VHUK",
                                    "endpoints":  [
                                                      "https://github.com/YuriDeiverson/Bento-Noctalia/releases/latest/download/latest.json"
                                                  ],
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                }
                }
}
